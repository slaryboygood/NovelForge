{
  "_comment": [
    "NovelForge V4-02 provider 配置示例（不含任何 secret）。",
    "api_key 只从 environment 读取（api_key_env 指定变量名），绝不写进本文件。",
    "默认 enabled=false：没有任何 provider 会被静默启用。",
    "启用方式：把 enabled 改为 true，并设置对应环境变量；",
    "也可以用环境变量 NOVELFORGE_LLM_PROVIDERS 直接注入 JSON。",
    "所有 base_url / model 都是占位示例，不是产品默认值。"
  ],
  "providers": [
    {
      "provider_id": "openai_compatible_example",
      "kind": "openai_compatible",
      "base_url": "https://api.example.com/v1",
      "api_key_env": "NOVELFORGE_LLM_API_KEY",
      "enabled": false,
      "default_model": "example-large",
      "timeout_s": 60.0,
      "connect_timeout_s": 10.0,
      "max_retries": 2,
      "models": [
        {
          "model_id": "example-large",
          "capabilities": ["structured_output", "creative", "critic", "large_context"],
          "context_tokens": 200000,
          "cost_tier": 5,
          "speed_tier": 3,
          "local": false,
          "supports_json_mode": true,
          "pricing_input_per_1k": null,
          "pricing_output_per_1k": null,
          "pricing_currency": "USD",
          "pricing_version": ""
        },
        {
          "model_id": "example-small",
          "capabilities": ["structured_output", "utility"],
          "context_tokens": 32000,
          "cost_tier": 1,
          "speed_tier": 1,
          "local": false,
          "supports_json_mode": true
        }
      ]
    },
    {
      "provider_id": "local_example",
      "kind": "openai_compatible",
      "base_url": "http://127.0.0.1:11434/v1",
      "api_key_env": "NOVELFORGE_LOCAL_LLM_API_KEY",
      "enabled": false,
      "default_model": "local-model",
      "timeout_s": 120.0,
      "max_retries": 0,
      "models": [
        {
          "model_id": "local-model",
          "capabilities": ["structured_output", "utility"],
          "context_tokens": 32000,
          "cost_tier": 1,
          "speed_tier": 4,
          "local": true,
          "supports_json_mode": false,
          "pricing_input_per_1k": 0.0,
          "pricing_output_per_1k": 0.0,
          "pricing_currency": "USD",
          "pricing_version": "self-hosted"
        }
      ]
    }
  ]
}

