{
  "$defs": {
    "AuthorBoundaryFinding": {
      "additionalProperties": false,
      "properties": {
        "boundary_id": {
          "title": "Boundary Id",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/BoundaryLevel"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "boundary_id",
        "level",
        "evidence"
      ],
      "title": "AuthorBoundaryFinding",
      "type": "object"
    },
    "BoundaryLevel": {
      "enum": [
        "HARD_FORBIDDEN",
        "SOFT_AVOID",
        "STYLE_WARNING"
      ],
      "title": "BoundaryLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chapter_id": {
      "pattern": "^\\d{4}$",
      "title": "Chapter Id",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/AuthorBoundaryFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "hard_fail": {
      "title": "Hard Fail",
      "type": "boolean"
    },
    "verdict": {
      "enum": [
        "PASS",
        "WARNING",
        "BLOCK"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "chapter_id",
    "findings",
    "hard_fail",
    "verdict"
  ],
  "title": "AuthorBoundaryReport",
  "type": "object"
}
