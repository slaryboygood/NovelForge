{
  "$defs": {
    "CanonLevel": {
      "enum": [
        "HARD_CANON",
        "HARD_PLOT",
        "RESTRICTED_TRUTH",
        "SOFT_PLAN"
      ],
      "title": "CanonLevel",
      "type": "string"
    },
    "ChapterLength": {
      "additionalProperties": false,
      "properties": {
        "length_class": {
          "$ref": "#/$defs/ChapterLengthClass",
          "default": "STANDARD"
        },
        "min_chinese_chars": {
          "default": 2600,
          "minimum": 1,
          "title": "Min Chinese Chars",
          "type": "integer"
        },
        "target_chinese_chars": {
          "default": 3200,
          "minimum": 1,
          "title": "Target Chinese Chars",
          "type": "integer"
        },
        "preferred_max_chinese_chars": {
          "default": 4000,
          "minimum": 1,
          "title": "Preferred Max Chinese Chars",
          "type": "integer"
        }
      },
      "title": "ChapterLength",
      "type": "object"
    },
    "ChapterLengthClass": {
      "enum": [
        "STANDARD",
        "KEY",
        "CLIMAX"
      ],
      "title": "ChapterLengthClass",
      "type": "string"
    },
    "CharacterParticipation": {
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "title": "Character Id",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "reason_present": {
          "title": "Reason Present",
          "type": "string"
        },
        "personal_goal": {
          "title": "Personal Goal",
          "type": "string"
        }
      },
      "required": [
        "character_id",
        "reason_present",
        "personal_goal"
      ],
      "title": "CharacterParticipation",
      "type": "object"
    },
    "ForeshadowInstructions": {
      "additionalProperties": false,
      "properties": {
        "plant": {
          "items": {
            "type": "string"
          },
          "title": "Plant",
          "type": "array"
        },
        "reinforce": {
          "items": {
            "type": "string"
          },
          "title": "Reinforce",
          "type": "array"
        },
        "payoff": {
          "items": {
            "type": "string"
          },
          "title": "Payoff",
          "type": "array"
        }
      },
      "title": "ForeshadowInstructions",
      "type": "object"
    },
    "KnowledgePermissions": {
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "items": {
            "type": "string"
          },
          "title": "Allowed",
          "type": "array"
        },
        "forbidden": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden",
          "type": "array"
        }
      },
      "title": "KnowledgePermissions",
      "type": "object"
    },
    "MysteryPermissions": {
      "additionalProperties": false,
      "properties": {
        "advance": {
          "items": {
            "type": "string"
          },
          "title": "Advance",
          "type": "array"
        },
        "keep_hidden": {
          "items": {
            "type": "string"
          },
          "title": "Keep Hidden",
          "type": "array"
        }
      },
      "title": "MysteryPermissions",
      "type": "object"
    },
    "PlotNodePermissions": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "items": {
            "type": "string"
          },
          "title": "Required",
          "type": "array"
        },
        "advance": {
          "items": {
            "type": "string"
          },
          "title": "Advance",
          "type": "array"
        },
        "optional": {
          "items": {
            "type": "string"
          },
          "title": "Optional",
          "type": "array"
        },
        "forbidden": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden",
          "type": "array"
        }
      },
      "required": [
        "required"
      ],
      "title": "PlotNodePermissions",
      "type": "object"
    },
    "ProfileSelection": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "profile_id",
        "fields"
      ],
      "title": "ProfileSelection",
      "type": "object"
    },
    "RelationshipTarget": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "title": "Relation Id",
          "type": "string"
        },
        "before": {
          "title": "Before",
          "type": "string"
        },
        "target_after": {
          "title": "Target After",
          "type": "string"
        },
        "permitted_change": {
          "title": "Permitted Change",
          "type": "string"
        }
      },
      "required": [
        "relation_id",
        "before",
        "target_after",
        "permitted_change"
      ],
      "title": "RelationshipTarget",
      "type": "object"
    },
    "ResourcePermissions": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "items": {
            "type": "string"
          },
          "title": "Available",
          "type": "array"
        },
        "required": {
          "items": {
            "type": "string"
          },
          "title": "Required",
          "type": "array"
        },
        "forbidden": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden",
          "type": "array"
        }
      },
      "title": "ResourcePermissions",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "canon_level": {
          "$ref": "#/$defs/CanonLevel"
        },
        "writer_visible": {
          "default": false,
          "title": "Writer Visible",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "section",
        "canon_level"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chapter_id": {
      "pattern": "^\\d{4}$",
      "title": "Chapter Id",
      "type": "string"
    },
    "volume": {
      "title": "Volume",
      "type": "string"
    },
    "arc": {
      "title": "Arc",
      "type": "string"
    },
    "chapter_goal": {
      "title": "Chapter Goal",
      "type": "string"
    },
    "characters": {
      "items": {
        "$ref": "#/$defs/CharacterParticipation"
      },
      "title": "Characters",
      "type": "array"
    },
    "relationship_target": {
      "items": {
        "$ref": "#/$defs/RelationshipTarget"
      },
      "title": "Relationship Target",
      "type": "array"
    },
    "plot_nodes": {
      "$ref": "#/$defs/PlotNodePermissions"
    },
    "equipment": {
      "$ref": "#/$defs/ResourcePermissions"
    },
    "abilities": {
      "$ref": "#/$defs/ResourcePermissions"
    },
    "knowledge": {
      "$ref": "#/$defs/KnowledgePermissions"
    },
    "mysteries": {
      "$ref": "#/$defs/MysteryPermissions"
    },
    "foreshadow": {
      "$ref": "#/$defs/ForeshadowInstructions"
    },
    "must_happen": {
      "items": {
        "type": "string"
      },
      "title": "Must Happen",
      "type": "array"
    },
    "must_not_happen": {
      "items": {
        "type": "string"
      },
      "title": "Must Not Happen",
      "type": "array"
    },
    "start_state": {
      "additionalProperties": true,
      "title": "Start State",
      "type": "object"
    },
    "target_end_state": {
      "additionalProperties": true,
      "title": "Target End State",
      "type": "object"
    },
    "ending_hook": {
      "title": "Ending Hook",
      "type": "string"
    },
    "length_class": {
      "$ref": "#/$defs/ChapterLengthClass",
      "default": "STANDARD"
    },
    "length": {
      "$ref": "#/$defs/ChapterLength"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "style_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProfileSelection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "character_voice_profile_ids": {
      "items": {
        "type": "string"
      },
      "title": "Character Voice Profile Ids",
      "type": "array"
    },
    "character_schedule_ids": {
      "items": {
        "type": "string"
      },
      "title": "Character Schedule Ids",
      "type": "array"
    },
    "location_constraint_ids": {
      "items": {
        "type": "string"
      },
      "title": "Location Constraint Ids",
      "type": "array"
    },
    "historical_event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Historical Event Ids",
      "type": "array"
    },
    "author_boundary_ids": {
      "items": {
        "type": "string"
      },
      "title": "Author Boundary Ids",
      "type": "array"
    }
  },
  "required": [
    "chapter_id",
    "volume",
    "arc",
    "chapter_goal",
    "characters",
    "plot_nodes",
    "must_happen",
    "must_not_happen",
    "start_state",
    "target_end_state",
    "ending_hook",
    "source_refs"
  ],
  "title": "ChapterCard",
  "type": "object"
}
