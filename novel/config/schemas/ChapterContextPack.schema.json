{
  "$defs": {
    "ChapterLength": {
      "additionalProperties": false,
      "properties": {
        "min_chinese_chars": {
          "default": 5000,
          "minimum": 1,
          "title": "Min Chinese Chars",
          "type": "integer"
        },
        "target_chinese_chars": {
          "default": 6000,
          "minimum": 1,
          "title": "Target Chinese Chars",
          "type": "integer"
        },
        "preferred_max_chinese_chars": {
          "default": 7500,
          "minimum": 1,
          "title": "Preferred Max Chinese Chars",
          "type": "integer"
        }
      },
      "title": "ChapterLength",
      "type": "object"
    },
    "ChapterPlan": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "pattern": "^\\d{4}$",
          "title": "Chapter Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "source_title": {
          "title": "Source Title",
          "type": "string"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        },
        "timeline": {
          "$ref": "#/$defs/TimelineBlock"
        },
        "pov": {
          "$ref": "#/$defs/PovBlock"
        },
        "location": {
          "items": {
            "type": "string"
          },
          "title": "Location",
          "type": "array"
        },
        "chapter_purpose": {
          "$ref": "#/$defs/ChapterPurpose"
        },
        "opening_state": {
          "additionalProperties": true,
          "title": "Opening State",
          "type": "object"
        },
        "must_happen": {
          "items": {
            "type": "string"
          },
          "title": "Must Happen",
          "type": "array"
        },
        "must_not_happen": {
          "items": {
            "type": "string"
          },
          "title": "Must Not Happen",
          "type": "array"
        },
        "conflicts": {
          "$ref": "#/$defs/Conflicts"
        },
        "information": {
          "$ref": "#/$defs/InformationBoundary"
        },
        "character_arc": {
          "$ref": "#/$defs/CharacterArc"
        },
        "foreshadowing": {
          "$ref": "#/$defs/ForeshadowingPlan"
        },
        "theme": {
          "$ref": "#/$defs/ThemeBlock"
        },
        "emotional_curve": {
          "items": {
            "type": "string"
          },
          "title": "Emotional Curve",
          "type": "array"
        },
        "ending_hook": {
          "title": "Ending Hook",
          "type": "string"
        },
        "target_words": {
          "exclusiveMinimum": 0,
          "title": "Target Words",
          "type": "integer"
        },
        "chapter_length": {
          "$ref": "#/$defs/ChapterLength"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/ScenePlan"
          },
          "title": "Scenes",
          "type": "array"
        }
      },
      "required": [
        "chapter_id",
        "title",
        "source_title",
        "source_file",
        "pov",
        "chapter_purpose",
        "character_arc",
        "theme",
        "ending_hook",
        "target_words"
      ],
      "title": "ChapterPlan",
      "type": "object"
    },
    "ChapterPurpose": {
      "additionalProperties": false,
      "properties": {
        "main": {
          "title": "Main",
          "type": "string"
        },
        "secondary": {
          "items": {
            "type": "string"
          },
          "title": "Secondary",
          "type": "array"
        }
      },
      "required": [
        "main"
      ],
      "title": "ChapterPurpose",
      "type": "object"
    },
    "CharacterArc": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "title": "Before",
          "type": "string"
        },
        "change": {
          "title": "Change",
          "type": "string"
        },
        "after": {
          "title": "After",
          "type": "string"
        }
      },
      "required": [
        "before",
        "change",
        "after"
      ],
      "title": "CharacterArc",
      "type": "object"
    },
    "CharacterState": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "default": "",
          "title": "Role",
          "type": "string"
        },
        "current_state": {
          "default": "",
          "title": "Current State",
          "type": "string"
        },
        "knowledge_state": {
          "items": {
            "type": "string"
          },
          "title": "Knowledge State",
          "type": "array"
        },
        "cognition": {
          "additionalProperties": true,
          "title": "Cognition",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "CharacterState",
      "type": "object"
    },
    "Conflicts": {
      "additionalProperties": false,
      "properties": {
        "external": {
          "items": {
            "type": "string"
          },
          "title": "External",
          "type": "array"
        },
        "internal": {
          "items": {
            "type": "string"
          },
          "title": "Internal",
          "type": "array"
        },
        "interpersonal": {
          "items": {
            "type": "string"
          },
          "title": "Interpersonal",
          "type": "array"
        }
      },
      "title": "Conflicts",
      "type": "object"
    },
    "ForeshadowingPlan": {
      "additionalProperties": false,
      "properties": {
        "plant": {
          "items": {
            "type": "string"
          },
          "title": "Plant",
          "type": "array"
        },
        "advance": {
          "items": {
            "type": "string"
          },
          "title": "Advance",
          "type": "array"
        },
        "resolve": {
          "items": {
            "type": "string"
          },
          "title": "Resolve",
          "type": "array"
        }
      },
      "title": "ForeshadowingPlan",
      "type": "object"
    },
    "InformationBoundary": {
      "additionalProperties": false,
      "properties": {
        "reveal": {
          "items": {
            "type": "string"
          },
          "title": "Reveal",
          "type": "array"
        },
        "hide": {
          "items": {
            "type": "string"
          },
          "title": "Hide",
          "type": "array"
        },
        "misunderstandings": {
          "items": {
            "type": "string"
          },
          "title": "Misunderstandings",
          "type": "array"
        }
      },
      "title": "InformationBoundary",
      "type": "object"
    },
    "MemoryItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "visibility": {
          "default": "global",
          "enum": [
            "global",
            "arc",
            "chapter-visible",
            "restricted"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "id",
        "summary",
        "source"
      ],
      "title": "MemoryItem",
      "type": "object"
    },
    "PovBlock": {
      "additionalProperties": false,
      "properties": {
        "character": {
          "title": "Character",
          "type": "string"
        },
        "perspective": {
          "default": "limited third-person",
          "title": "Perspective",
          "type": "string"
        }
      },
      "required": [
        "character"
      ],
      "title": "PovBlock",
      "type": "object"
    },
    "ScenePlan": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "purpose": {
          "default": "",
          "title": "Purpose",
          "type": "string"
        },
        "entering_state": {
          "default": "",
          "title": "Entering State",
          "type": "string"
        },
        "event": {
          "default": "",
          "title": "Event",
          "type": "string"
        },
        "conflict": {
          "default": "",
          "title": "Conflict",
          "type": "string"
        },
        "character_action": {
          "default": "",
          "title": "Character Action",
          "type": "string"
        },
        "choice": {
          "default": "",
          "title": "Choice",
          "type": "string"
        },
        "reveal": {
          "items": {
            "type": "string"
          },
          "title": "Reveal",
          "type": "array"
        },
        "hide": {
          "items": {
            "type": "string"
          },
          "title": "Hide",
          "type": "array"
        },
        "state_change": {
          "default": "",
          "title": "State Change",
          "type": "string"
        },
        "exit_state": {
          "default": "",
          "title": "Exit State",
          "type": "string"
        },
        "estimated_chars": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Chars"
        }
      },
      "required": [
        "scene_id"
      ],
      "title": "ScenePlan",
      "type": "object"
    },
    "ThemeBlock": {
      "additionalProperties": false,
      "properties": {
        "silicon_polishing": {
          "title": "Silicon Polishing",
          "type": "string"
        },
        "subjective_elevation": {
          "title": "Subjective Elevation",
          "type": "string"
        },
        "daoist_dimension": {
          "title": "Daoist Dimension",
          "type": "string"
        },
        "implicit_question": {
          "title": "Implicit Question",
          "type": "string"
        }
      },
      "required": [
        "silicon_polishing",
        "subjective_elevation",
        "daoist_dimension",
        "implicit_question"
      ],
      "title": "ThemeBlock",
      "type": "object"
    },
    "TimelineBlock": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        },
        "elapsed_from_previous": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed From Previous"
        }
      },
      "title": "TimelineBlock",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chapter_id": {
      "pattern": "^\\d{4}$",
      "title": "Chapter Id",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/ChapterPlan"
    },
    "current_arc_summary": {
      "title": "Current Arc Summary",
      "type": "string"
    },
    "recent_chapter_summaries": {
      "items": {
        "type": "string"
      },
      "title": "Recent Chapter Summaries",
      "type": "array"
    },
    "current_pov_state": {
      "$ref": "#/$defs/CharacterState"
    },
    "involved_character_states": {
      "items": {
        "$ref": "#/$defs/CharacterState"
      },
      "title": "Involved Character States",
      "type": "array"
    },
    "relevant_world_rules": {
      "items": {
        "$ref": "#/$defs/MemoryItem"
      },
      "title": "Relevant World Rules",
      "type": "array"
    },
    "relevant_foreshadowing": {
      "items": {
        "$ref": "#/$defs/MemoryItem"
      },
      "title": "Relevant Foreshadowing",
      "type": "array"
    },
    "relevant_locations": {
      "items": {
        "$ref": "#/$defs/MemoryItem"
      },
      "title": "Relevant Locations",
      "type": "array"
    },
    "relevant_items": {
      "items": {
        "$ref": "#/$defs/MemoryItem"
      },
      "title": "Relevant Items",
      "type": "array"
    },
    "canon_memory": {
      "items": {
        "$ref": "#/$defs/MemoryItem"
      },
      "title": "Canon Memory",
      "type": "array"
    },
    "narrative_memory": {
      "items": {
        "$ref": "#/$defs/MemoryItem"
      },
      "title": "Narrative Memory",
      "type": "array"
    },
    "author_intent_visible": {
      "items": {
        "$ref": "#/$defs/MemoryItem"
      },
      "title": "Author Intent Visible",
      "type": "array"
    },
    "excluded_author_intent_ids": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Author Intent Ids",
      "type": "array"
    },
    "writer_brief": {
      "title": "Writer Brief",
      "type": "string"
    }
  },
  "required": [
    "chapter_id",
    "plan",
    "current_arc_summary",
    "current_pov_state",
    "writer_brief"
  ],
  "title": "ChapterContextPack",
  "type": "object"
}
