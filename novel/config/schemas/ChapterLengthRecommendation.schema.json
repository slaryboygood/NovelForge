{
  "$defs": {
    "CanonLevel": {
      "enum": [
        "HARD_CANON",
        "HARD_PLOT",
        "RESTRICTED_TRUTH",
        "SOFT_PLAN"
      ],
      "title": "CanonLevel",
      "type": "string"
    },
    "ChapterLengthClass": {
      "enum": [
        "STANDARD",
        "KEY",
        "CLIMAX"
      ],
      "title": "ChapterLengthClass",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "canon_level": {
          "$ref": "#/$defs/CanonLevel"
        },
        "writer_visible": {
          "default": false,
          "title": "Writer Visible",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "section",
        "canon_level"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chapter_id": {
      "pattern": "^\\d{4}$",
      "title": "Chapter Id",
      "type": "string"
    },
    "length_class": {
      "$ref": "#/$defs/ChapterLengthClass"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "status": {
      "enum": [
        "RULE_CLASSIFIED",
        "AUTHOR_REVIEW_REQUIRED"
      ],
      "title": "Status",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Source Refs",
      "type": "array"
    }
  },
  "required": [
    "chapter_id",
    "length_class",
    "reason",
    "status",
    "source_refs"
  ],
  "title": "ChapterLengthRecommendation",
  "type": "object"
}
