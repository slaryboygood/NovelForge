{
  "$defs": {
    "CanonLevel": {
      "enum": [
        "HARD_CANON",
        "HARD_PLOT",
        "RESTRICTED_TRUTH",
        "SOFT_PLAN"
      ],
      "title": "CanonLevel",
      "type": "string"
    },
    "ChapterLengthClass": {
      "enum": [
        "STANDARD",
        "KEY",
        "CLIMAX"
      ],
      "title": "ChapterLengthClass",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "canon_level": {
          "$ref": "#/$defs/CanonLevel"
        },
        "writer_visible": {
          "default": false,
          "title": "Writer Visible",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "section",
        "canon_level"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chapter_id": {
      "pattern": "^\\d{4}$",
      "title": "Chapter Id",
      "type": "string"
    },
    "chapter_intent": {
      "title": "Chapter Intent",
      "type": "string"
    },
    "length_class": {
      "$ref": "#/$defs/ChapterLengthClass"
    },
    "characters": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Characters",
      "type": "array"
    },
    "voice_profile_ids": {
      "items": {
        "type": "string"
      },
      "title": "Voice Profile Ids",
      "type": "array"
    },
    "start_state": {
      "additionalProperties": true,
      "title": "Start State",
      "type": "object"
    },
    "knowledge_allowed": {
      "items": {
        "type": "string"
      },
      "title": "Knowledge Allowed",
      "type": "array"
    },
    "knowledge_forbidden": {
      "items": {
        "type": "string"
      },
      "title": "Knowledge Forbidden",
      "type": "array"
    },
    "equipment": {
      "items": {
        "type": "string"
      },
      "title": "Equipment",
      "type": "array"
    },
    "abilities": {
      "items": {
        "type": "string"
      },
      "title": "Abilities",
      "type": "array"
    },
    "location": {
      "title": "Location",
      "type": "string"
    },
    "travel_rules": {
      "items": {
        "type": "string"
      },
      "title": "Travel Rules",
      "type": "array"
    },
    "mysteries_advance": {
      "items": {
        "type": "string"
      },
      "title": "Mysteries Advance",
      "type": "array"
    },
    "mysteries_hidden": {
      "items": {
        "type": "string"
      },
      "title": "Mysteries Hidden",
      "type": "array"
    },
    "foreshadow": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Foreshadow",
      "type": "object"
    },
    "must_happen": {
      "items": {
        "type": "string"
      },
      "title": "Must Happen",
      "type": "array"
    },
    "must_not_happen": {
      "items": {
        "type": "string"
      },
      "title": "Must Not Happen",
      "type": "array"
    },
    "style_directives": {
      "items": {
        "type": "string"
      },
      "title": "Style Directives",
      "type": "array"
    },
    "author_boundaries": {
      "items": {
        "type": "string"
      },
      "title": "Author Boundaries",
      "type": "array"
    },
    "ending_target": {
      "title": "Ending Target",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "restricted_leak": {
      "title": "Restricted Leak",
      "type": "boolean"
    },
    "archive_leak": {
      "title": "Archive Leak",
      "type": "boolean"
    },
    "unrelated_character_overload": {
      "title": "Unrelated Character Overload",
      "type": "boolean"
    },
    "author_tbd": {
      "items": {
        "type": "string"
      },
      "title": "Author Tbd",
      "type": "array"
    },
    "ready_for_phase6": {
      "title": "Ready For Phase6",
      "type": "boolean"
    }
  },
  "required": [
    "chapter_id",
    "chapter_intent",
    "length_class",
    "characters",
    "voice_profile_ids",
    "start_state",
    "knowledge_allowed",
    "knowledge_forbidden",
    "equipment",
    "abilities",
    "location",
    "travel_rules",
    "mysteries_advance",
    "mysteries_hidden",
    "foreshadow",
    "must_happen",
    "must_not_happen",
    "style_directives",
    "author_boundaries",
    "ending_target",
    "source_refs",
    "restricted_leak",
    "archive_leak",
    "unrelated_character_overload",
    "ready_for_phase6"
  ],
  "title": "ChapterPreflight",
  "type": "object"
}
