{
  "$defs": {
    "ArtifactRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "created_by_plugin": {
          "title": "Created By Plugin",
          "type": "string"
        },
        "plugin_version": {
          "title": "Plugin Version",
          "type": "string"
        },
        "skill_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Hash"
        },
        "input_artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Input Artifacts",
          "type": "array"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "output_hash": {
          "title": "Output Hash",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "status": {
          "default": "VALID",
          "enum": [
            "VALID",
            "STALE",
            "FAILED",
            "SUPERSEDED"
          ],
          "title": "Status",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "artifact_id",
        "stage",
        "path",
        "created_by_plugin",
        "plugin_version",
        "input_hash",
        "output_hash",
        "created_at"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "chapter_id": {
      "pattern": "^\\d{4}$",
      "title": "Chapter Id",
      "type": "string"
    },
    "pipeline_id": {
      "title": "Pipeline Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "CREATED",
        "PLANNING",
        "PLAN_VALIDATED",
        "CONTEXT_BUILT",
        "WRITING",
        "DRAFT_VALIDATED",
        "REVIEWING",
        "STATE_EXTRACTED",
        "READY_TO_COMMIT",
        "COMMITTED",
        "BLOCKED",
        "ABORTED"
      ],
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "snapshot_path": {
      "title": "Snapshot Path",
      "type": "string"
    },
    "artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/ArtifactRecord"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "stale_stages": {
      "items": {
        "type": "string"
      },
      "title": "Stale Stages",
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "chapter_id",
    "pipeline_id",
    "status",
    "created_at",
    "updated_at",
    "snapshot_path"
  ],
  "title": "ChapterRunRecord",
  "type": "object"
}
