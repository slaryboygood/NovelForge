{
  "$defs": {
    "ChapterStatus": {
      "enum": [
        "PLANNED",
        "CONTEXT_BUILT",
        "DRAFTED",
        "REVIEWED",
        "REVISION_REQUIRED",
        "REVISED",
        "FINAL_REVIEW",
        "APPROVED",
        "STATE_DELTA_CREATED",
        "STATE_COMMITTED",
        "BLOCKED"
      ],
      "title": "ChapterStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chapter_id": {
      "pattern": "^\\d{4}$",
      "title": "Chapter Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ChapterStatus"
    },
    "artifacts": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "history": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "History",
      "type": "array"
    }
  },
  "required": [
    "chapter_id",
    "status"
  ],
  "title": "ChapterWorkflowState",
  "type": "object"
}
