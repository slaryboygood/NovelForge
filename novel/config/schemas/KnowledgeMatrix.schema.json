{
  "$defs": {
    "KnowledgeLevel": {
      "enum": [
        "UNKNOWN",
        "SUSPECTED",
        "PARTIAL",
        "KNOWN",
        "FALSE_BELIEF"
      ],
      "title": "KnowledgeLevel",
      "type": "string"
    },
    "KnowledgeTruth": {
      "additionalProperties": false,
      "properties": {
        "truth_id": {
          "title": "Truth Id",
          "type": "string"
        },
        "public_label": {
          "title": "Public Label",
          "type": "string"
        },
        "restricted_truth": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Restricted Truth"
        },
        "subjects": {
          "additionalProperties": {
            "$ref": "#/$defs/SubjectKnowledge"
          },
          "title": "Subjects",
          "type": "object"
        },
        "writer_visible_truth": {
          "default": false,
          "title": "Writer Visible Truth",
          "type": "boolean"
        }
      },
      "required": [
        "truth_id",
        "public_label",
        "subjects"
      ],
      "title": "KnowledgeTruth",
      "type": "object"
    },
    "SubjectKnowledge": {
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/KnowledgeLevel"
        },
        "known_summary": {
          "default": "",
          "title": "Known Summary",
          "type": "string"
        },
        "false_belief": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "False Belief"
        },
        "evidence_chapters": {
          "items": {
            "type": "integer"
          },
          "title": "Evidence Chapters",
          "type": "array"
        }
      },
      "required": [
        "subject_id",
        "state"
      ],
      "title": "SubjectKnowledge",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entries": {
      "additionalProperties": {
        "$ref": "#/$defs/KnowledgeTruth"
      },
      "title": "Entries",
      "type": "object"
    }
  },
  "title": "KnowledgeMatrix",
  "type": "object"
}
