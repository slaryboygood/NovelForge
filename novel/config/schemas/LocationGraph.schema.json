{
  "$defs": {
    "CanonLevel": {
      "enum": [
        "HARD_CANON",
        "HARD_PLOT",
        "RESTRICTED_TRUTH",
        "SOFT_PLAN"
      ],
      "title": "CanonLevel",
      "type": "string"
    },
    "LocationConnection": {
      "additionalProperties": false,
      "properties": {
        "to_location_id": {
          "title": "To Location Id",
          "type": "string"
        },
        "min_hours": {
          "minimum": 0,
          "title": "Min Hours",
          "type": "number"
        },
        "max_hours": {
          "minimum": 0,
          "title": "Max Hours",
          "type": "number"
        },
        "travel_methods": {
          "items": {
            "type": "string"
          },
          "title": "Travel Methods",
          "type": "array"
        },
        "access_requirement": {
          "items": {
            "type": "string"
          },
          "title": "Access Requirement",
          "type": "array"
        },
        "danger": {
          "items": {
            "type": "string"
          },
          "title": "Danger",
          "type": "array"
        },
        "special_rules": {
          "items": {
            "type": "string"
          },
          "title": "Special Rules",
          "type": "array"
        }
      },
      "required": [
        "to_location_id",
        "min_hours",
        "max_hours",
        "travel_methods"
      ],
      "title": "LocationConnection",
      "type": "object"
    },
    "LocationNode": {
      "additionalProperties": false,
      "properties": {
        "location_id": {
          "title": "Location Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "region": {
          "title": "Region",
          "type": "string"
        },
        "connections": {
          "items": {
            "$ref": "#/$defs/LocationConnection"
          },
          "title": "Connections",
          "type": "array"
        },
        "special_rules": {
          "items": {
            "type": "string"
          },
          "title": "Special Rules",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "location_id",
        "name",
        "region",
        "connections",
        "source_refs"
      ],
      "title": "LocationNode",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "canon_level": {
          "$ref": "#/$defs/CanonLevel"
        },
        "writer_visible": {
          "default": false,
          "title": "Writer Visible",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "section",
        "canon_level"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "graph_id": {
      "title": "Graph Id",
      "type": "string"
    },
    "locations": {
      "additionalProperties": {
        "$ref": "#/$defs/LocationNode"
      },
      "title": "Locations",
      "type": "object"
    }
  },
  "required": [
    "graph_id",
    "locations"
  ],
  "title": "LocationGraph",
  "type": "object"
}
