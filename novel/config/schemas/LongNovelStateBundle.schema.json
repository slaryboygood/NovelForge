{
  "$defs": {
    "AbilityRuntimeState": {
      "additionalProperties": false,
      "properties": {
        "ability_id": {
          "title": "Ability Id",
          "type": "string"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AbilityStatus"
        },
        "current_level": {
          "minimum": 0,
          "title": "Current Level",
          "type": "integer"
        },
        "unlock_node_reached": {
          "default": false,
          "title": "Unlock Node Reached",
          "type": "boolean"
        },
        "current_damage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Damage"
        },
        "updated_through_chapter": {
          "minimum": 0,
          "title": "Updated Through Chapter",
          "type": "integer"
        }
      },
      "required": [
        "ability_id",
        "owner",
        "status",
        "current_level",
        "updated_through_chapter"
      ],
      "title": "AbilityRuntimeState",
      "type": "object"
    },
    "AbilityStatus": {
      "enum": [
        "LOCKED",
        "AVAILABLE",
        "ACTIVE",
        "DAMAGED",
        "DISABLED"
      ],
      "title": "AbilityStatus",
      "type": "string"
    },
    "CharacterRuntimeState": {
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "title": "Character Id",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "physical_state": {
          "title": "Physical State",
          "type": "string"
        },
        "psychological_state": {
          "title": "Psychological State",
          "type": "string"
        },
        "current_goal": {
          "title": "Current Goal",
          "type": "string"
        },
        "current_stance": {
          "title": "Current Stance",
          "type": "string"
        },
        "current_abilities": {
          "items": {
            "type": "string"
          },
          "title": "Current Abilities",
          "type": "array"
        },
        "recent_major_events": {
          "items": {
            "type": "string"
          },
          "title": "Recent Major Events",
          "type": "array"
        },
        "current_arc_stage": {
          "title": "Current Arc Stage",
          "type": "string"
        },
        "updated_through_chapter": {
          "minimum": 0,
          "title": "Updated Through Chapter",
          "type": "integer"
        }
      },
      "required": [
        "character_id",
        "location",
        "physical_state",
        "psychological_state",
        "current_goal",
        "current_stance",
        "current_arc_stage",
        "updated_through_chapter"
      ],
      "title": "CharacterRuntimeState",
      "type": "object"
    },
    "EquipmentRuntimeState": {
      "additionalProperties": false,
      "properties": {
        "equipment_id": {
          "title": "Equipment Id",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "condition": {
          "title": "Condition",
          "type": "string"
        },
        "acquired": {
          "default": false,
          "title": "Acquired",
          "type": "boolean"
        },
        "upgraded": {
          "default": false,
          "title": "Upgraded",
          "type": "boolean"
        },
        "lost": {
          "default": false,
          "title": "Lost",
          "type": "boolean"
        },
        "destroyed": {
          "default": false,
          "title": "Destroyed",
          "type": "boolean"
        },
        "available_to_use": {
          "default": false,
          "title": "Available To Use",
          "type": "boolean"
        },
        "updated_through_chapter": {
          "minimum": 0,
          "title": "Updated Through Chapter",
          "type": "integer"
        }
      },
      "required": [
        "equipment_id",
        "location",
        "condition",
        "updated_through_chapter"
      ],
      "title": "EquipmentRuntimeState",
      "type": "object"
    },
    "ForeshadowLedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "foreshadow_id": {
          "title": "Foreshadow Id",
          "type": "string"
        },
        "public_description": {
          "title": "Public Description",
          "type": "string"
        },
        "restricted_meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Restricted Meaning"
        },
        "status": {
          "$ref": "#/$defs/ForeshadowStatus"
        },
        "plant_window": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Plant Window",
          "type": "array"
        },
        "reinforce_window": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Reinforce Window",
          "type": "array"
        },
        "payoff_window": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Payoff Window",
          "type": "array"
        },
        "evidence_chapters": {
          "items": {
            "type": "integer"
          },
          "title": "Evidence Chapters",
          "type": "array"
        }
      },
      "required": [
        "foreshadow_id",
        "public_description",
        "status",
        "plant_window",
        "reinforce_window",
        "payoff_window"
      ],
      "title": "ForeshadowLedgerEntry",
      "type": "object"
    },
    "ForeshadowStatus": {
      "enum": [
        "PLANNED",
        "PLANTED",
        "REINFORCED",
        "PARTIALLY_REVEALED",
        "PAID_OFF",
        "ABANDONED"
      ],
      "title": "ForeshadowStatus",
      "type": "string"
    },
    "KnowledgeLevel": {
      "enum": [
        "UNKNOWN",
        "SUSPECTED",
        "PARTIAL",
        "KNOWN",
        "FALSE_BELIEF"
      ],
      "title": "KnowledgeLevel",
      "type": "string"
    },
    "KnowledgeMatrix": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "additionalProperties": {
            "$ref": "#/$defs/KnowledgeTruth"
          },
          "title": "Entries",
          "type": "object"
        }
      },
      "title": "KnowledgeMatrix",
      "type": "object"
    },
    "KnowledgeTruth": {
      "additionalProperties": false,
      "properties": {
        "truth_id": {
          "title": "Truth Id",
          "type": "string"
        },
        "public_label": {
          "title": "Public Label",
          "type": "string"
        },
        "restricted_truth": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Restricted Truth"
        },
        "subjects": {
          "additionalProperties": {
            "$ref": "#/$defs/SubjectKnowledge"
          },
          "title": "Subjects",
          "type": "object"
        },
        "writer_visible_truth": {
          "default": false,
          "title": "Writer Visible Truth",
          "type": "boolean"
        }
      },
      "required": [
        "truth_id",
        "public_label",
        "subjects"
      ],
      "title": "KnowledgeTruth",
      "type": "object"
    },
    "MysteryState": {
      "additionalProperties": false,
      "properties": {
        "mystery_id": {
          "title": "Mystery Id",
          "type": "string"
        },
        "public_question": {
          "title": "Public Question",
          "type": "string"
        },
        "truth": {
          "title": "Truth",
          "type": "string"
        },
        "truth_restricted": {
          "default": true,
          "title": "Truth Restricted",
          "type": "boolean"
        },
        "reader_state": {
          "$ref": "#/$defs/KnowledgeLevel"
        },
        "character_states": {
          "additionalProperties": {
            "$ref": "#/$defs/KnowledgeLevel"
          },
          "title": "Character States",
          "type": "object"
        },
        "false_beliefs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "False Beliefs",
          "type": "object"
        },
        "reveal_stage": {
          "title": "Reveal Stage",
          "type": "string"
        },
        "foreshadow_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Foreshadow Node Ids",
          "type": "array"
        },
        "payoff_node_id": {
          "title": "Payoff Node Id",
          "type": "string"
        },
        "forbidden_before_chapter": {
          "minimum": 1,
          "title": "Forbidden Before Chapter",
          "type": "integer"
        }
      },
      "required": [
        "mystery_id",
        "public_question",
        "truth",
        "reader_state",
        "character_states",
        "reveal_stage",
        "payoff_node_id",
        "forbidden_before_chapter"
      ],
      "title": "MysteryState",
      "type": "object"
    },
    "RelationshipState": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "title": "Relation Id",
          "type": "string"
        },
        "participants": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Participants",
          "type": "array"
        },
        "surface_relation": {
          "title": "Surface Relation",
          "type": "string"
        },
        "trust": {
          "maximum": 100,
          "minimum": -100,
          "title": "Trust",
          "type": "integer"
        },
        "respect": {
          "maximum": 100,
          "minimum": -100,
          "title": "Respect",
          "type": "integer"
        },
        "fear": {
          "maximum": 100,
          "minimum": 0,
          "title": "Fear",
          "type": "integer"
        },
        "emotional_debt": {
          "default": 0,
          "title": "Emotional Debt",
          "type": "integer"
        },
        "shared_secrets": {
          "items": {
            "type": "string"
          },
          "title": "Shared Secrets",
          "type": "array"
        },
        "unresolved_conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Conflicts",
          "type": "array"
        },
        "current_stage": {
          "title": "Current Stage",
          "type": "string"
        },
        "next_target_stage": {
          "title": "Next Target Stage",
          "type": "string"
        },
        "evidence_chapters": {
          "items": {
            "type": "integer"
          },
          "title": "Evidence Chapters",
          "type": "array"
        }
      },
      "required": [
        "relation_id",
        "participants",
        "surface_relation",
        "trust",
        "respect",
        "fear",
        "current_stage",
        "next_target_stage"
      ],
      "title": "RelationshipState",
      "type": "object"
    },
    "SubjectKnowledge": {
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/KnowledgeLevel"
        },
        "known_summary": {
          "default": "",
          "title": "Known Summary",
          "type": "string"
        },
        "false_belief": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "False Belief"
        },
        "evidence_chapters": {
          "items": {
            "type": "integer"
          },
          "title": "Evidence Chapters",
          "type": "array"
        }
      },
      "required": [
        "subject_id",
        "state"
      ],
      "title": "SubjectKnowledge",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "state_version": {
      "title": "State Version",
      "type": "string"
    },
    "updated_through_chapter": {
      "minimum": 0,
      "title": "Updated Through Chapter",
      "type": "integer"
    },
    "characters": {
      "additionalProperties": {
        "$ref": "#/$defs/CharacterRuntimeState"
      },
      "title": "Characters",
      "type": "object"
    },
    "relationships": {
      "additionalProperties": {
        "$ref": "#/$defs/RelationshipState"
      },
      "title": "Relationships",
      "type": "object"
    },
    "knowledge": {
      "$ref": "#/$defs/KnowledgeMatrix"
    },
    "equipment": {
      "additionalProperties": {
        "$ref": "#/$defs/EquipmentRuntimeState"
      },
      "title": "Equipment",
      "type": "object"
    },
    "abilities": {
      "additionalProperties": {
        "$ref": "#/$defs/AbilityRuntimeState"
      },
      "title": "Abilities",
      "type": "object"
    },
    "mysteries": {
      "additionalProperties": {
        "$ref": "#/$defs/MysteryState"
      },
      "title": "Mysteries",
      "type": "object"
    },
    "foreshadowing": {
      "additionalProperties": {
        "$ref": "#/$defs/ForeshadowLedgerEntry"
      },
      "title": "Foreshadowing",
      "type": "object"
    },
    "timeline_facts": {
      "items": {
        "type": "string"
      },
      "title": "Timeline Facts",
      "type": "array"
    },
    "world_facts": {
      "items": {
        "type": "string"
      },
      "title": "World Facts",
      "type": "array"
    },
    "active_subplots": {
      "items": {
        "type": "string"
      },
      "title": "Active Subplots",
      "type": "array"
    },
    "recent_chapter_summaries": {
      "items": {
        "type": "string"
      },
      "title": "Recent Chapter Summaries",
      "type": "array"
    }
  },
  "required": [
    "state_version",
    "updated_through_chapter"
  ],
  "title": "LongNovelStateBundle",
  "type": "object"
}
