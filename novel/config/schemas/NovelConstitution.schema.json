        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "canon_level": {
          "$ref": "#/$defs/CanonLevel"
        },
        "writer_visible": {
          "default": false,
          "title": "Writer Visible",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "section",
        "canon_level"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
