{
  "$defs": {
    "CanonLevel": {
      "enum": [
        "HARD_CANON",
        "HARD_PLOT",
        "RESTRICTED_TRUTH",
        "SOFT_PLAN"
      ],
      "title": "CanonLevel",
      "type": "string"
    },
    "HardPlotNode": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "volume_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume Id"
        },
        "chapter_window": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chapter Window"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "node_id",
        "summary"
      ],
      "title": "HardPlotNode",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
