{
  "$defs": {
    "PipelineStageSelection": {
      "additionalProperties": false,
      "properties": {
        "plugin": {
          "title": "Plugin",
          "type": "string"
        }
      },
      "required": [
        "plugin"
      ],
      "title": "PipelineStageSelection",
      "type": "object"
    },
    "ReviewerSelection": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "serial",
          "enum": [
            "serial",
            "parallel"
          ],
          "title": "Mode",
          "type": "string"
        },
        "plugins": {
          "items": {
            "type": "string"
          },
          "title": "Plugins",
          "type": "array"
        }
      },
      "title": "ReviewerSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "pipeline_id": {
      "title": "Pipeline Id",
      "type": "string"
    },
    "version": {
      "default": "1.0.0",
      "title": "Version",
      "type": "string"
    },
    "auto_commit": {
      "default": false,
      "title": "Auto Commit",
      "type": "boolean"
    },
    "planner": {
      "$ref": "#/$defs/PipelineStageSelection"
    },
    "writer": {
      "$ref": "#/$defs/PipelineStageSelection"
    },
    "reviewers": {
      "$ref": "#/$defs/ReviewerSelection"
    },
    "revision_planner": {
      "anyOf": [
        {
          "$ref": "#/$defs/PipelineStageSelection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rewriter": {
      "anyOf": [
        {
          "$ref": "#/$defs/PipelineStageSelection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "state_extractor": {
      "$ref": "#/$defs/PipelineStageSelection"
    },
    "publisher_enabled": {
      "default": false,
      "title": "Publisher Enabled",
      "type": "boolean"
    }
  },
  "required": [
    "pipeline_id",
    "planner",
    "writer",
    "state_extractor"
  ],
  "title": "PipelineConfig",
  "type": "object"
}
