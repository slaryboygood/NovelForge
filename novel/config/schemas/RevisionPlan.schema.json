{
  "$defs": {
    "RevisionAction": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "instruction": {
          "title": "Instruction",
          "type": "string"
        },
        "owner": {
          "const": "rewriter",
          "default": "rewriter",
          "title": "Owner",
          "type": "string"
        },
        "priority": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Priority",
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "instruction"
      ],
      "title": "RevisionAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chapter_id": {
      "pattern": "^\\d{4}$",
      "title": "Chapter Id",
      "type": "string"
    },
    "from_version": {
      "title": "From Version",
      "type": "string"
    },
    "to_version": {
      "title": "To Version",
      "type": "string"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/RevisionAction"
      },
      "title": "Actions",
      "type": "array"
    },
    "locked_constraints": {
      "items": {
        "type": "string"
      },
      "title": "Locked Constraints",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    }
  },
  "required": [
    "chapter_id",
    "from_version",
    "to_version"
  ],
  "title": "RevisionPlan",
  "type": "object"
}
